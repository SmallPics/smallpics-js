{
	"name": "smallpics-js",
	"version": "0.0.0",
	"description": "Small Pics URL generation for JavaScript",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SmallPics/smallpics-js.git"
	},
	"files": [
		"dist",
		"src/components",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"browser": null,
			"default": "./dist/server.js"
		}
	},
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pretest": "npm run build",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"typescript": "^6.0.0",
		"prettier": "^3.9.10",
		"vitest": "^4.0.0"
	}
}
